#!/command/with-contenv sh
# s6 log handler for the ingest-poller service.
# s6-supervise reads stdout/stderr and pipes them to s6-log, which appends to
# $S6_LOG/.../main.log and error.log (s6-log's standard two-file convention).
# (The run script ALSO tees to a persistent file under /opt/data/services/logs
# so activity survives a container re-creation.)
exec s6-log -s 10M /run/service/ingest-poller/log 2>&1
